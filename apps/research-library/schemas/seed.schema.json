{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "session_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "principal_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,79}$"
                },
                "role": {
                  "enum": [
                    "none",
                    "viewer",
                    "editor"
                  ]
                }
              },
              "required": [
                "principal_id",
                "role"
              ],
              "additionalProperties": false
            },
            "maxItems": 25
          }
        },
        "required": [
          "id",
          "grants"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "library_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "catalog_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 20
          },
          "year": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 9999
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 20
          },
          "reading_status": {
            "enum": [
              "unread",
              "reading",
              "read"
            ]
          }
        },
        "required": [
          "id",
          "library_id",
          "catalog_id",
          "revision",
          "title",
          "authors",
          "year",
          "tags",
          "reading_status"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 20
          },
          "year": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 9999
          }
        },
        "required": [
          "id",
          "title",
          "authors",
          "year"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "author": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "record_id",
          "author",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "account_id",
    "session_expires_at",
    "libraries",
    "records",
    "catalog",
    "notes"
  ],
  "additionalProperties": false
}
