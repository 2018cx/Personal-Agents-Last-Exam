{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "library.permission_change"
    },
    "payload": {
      "type": "object",
      "properties": {
        "library_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "role": {
          "enum": [
            "none",
            "viewer",
            "editor"
          ]
        }
      },
      "required": [
        "library_id",
        "principal_id",
        "role"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false
}
