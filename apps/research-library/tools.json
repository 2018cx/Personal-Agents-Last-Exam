[
  {
    "name": "library.search",
    "description": "Find scoped records by optional text, tag, and reading status.",
    "read_only": true,
    "scope": "library.search",
    "resource_target": "bound account and authorized library",
    "inputSchema": {
      "type": "object",
      "properties": {
        "library_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reading_status": {
          "enum": [
            "unread",
            "reading",
            "read"
          ]
        }
      },
      "required": [
        "library_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "library"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999999
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "library_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "catalog_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999999
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 20
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 20
              },
              "reading_status": {
                "enum": [
                  "unread",
                  "reading",
                  "read"
                ]
              }
            },
            "required": [
              "id",
              "library_id",
              "catalog_id",
              "revision",
              "title",
              "authors",
              "year",
              "tags",
              "reading_status"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "records"
      ],
      "additionalProperties": false
    }
  },
