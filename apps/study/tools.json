[
  {
    "name": "study.list_cards",
    "description": "Read seeded cards and decks without revealing answers.",
    "read_only": true,
    "scope": "study.list_cards",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "study"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "decks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "deck_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "reviewed": {
                "type": "boolean"
              },
              "stage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "due_day": {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000
              },
              "card_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "id",
              "deck_id",
              "prompt",
              "reviewed",
              "stage",
              "due_day",
              "card_version"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "decks",
        "cards"
      ],
      "additionalProperties": false
    }
  },
