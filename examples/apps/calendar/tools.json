            },
            "version": {
              "type": "object",
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "epoch",
                "revision"
