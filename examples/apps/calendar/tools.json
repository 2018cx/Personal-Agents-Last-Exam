                    "minLength": 1,
                    "maxLength": 150
                  },
                  "account_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "calendar_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "organizer_person_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "attendees": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "uniqueItems": true
                  },
                  "location": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "confirmed",
                      "cancelled"
                    ]
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
